{
  "description": "Rule IR v2 parity vectors. Run by the Rust rule-core (shared_parity_vectors), the Java EdgeRuleInterpreter (EdgeRuleIrParityTest) and, under -Pnative-core, the JNI build against the Java interpreter (EdgeEngineNativeIT). Every rule reads its own field so each case triggers only the rules it names; scores are distinct powers of two. Rule 13 is const true and fires in every case.",
  "bundle": {
    "version": 9001,
    "psp_id": 42,
    "ir_version": 2,
    "lists": {
      "countries": ["IR", "kp", "42"],
      "decimals": ["0.5", "0.0000001", "12345678.9"]
    },
    "rules": [
      {"id": 1, "name": "gt", "condition": {"type": "cmp", "field": "f_gt", "op": "GT", "value": 100}, "action": "ALERT", "score": 1},
      {"id": 2, "name": "gte", "condition": {"type": "cmp", "field": "f_gte", "op": "GTE", "value": 100}, "action": "ALERT", "score": 2},
      {"id": 3, "name": "lt", "condition": {"type": "cmp", "field": "f_lt", "op": "LT", "value": 100}, "action": "ALERT", "score": 4},
      {"id": 4, "name": "lte", "condition": {"type": "cmp", "field": "f_lte", "op": "LTE", "value": 100}, "action": "ALERT", "score": 8},
      {"id": 5, "name": "eq num", "condition": {"type": "cmp", "field": "f_eq_num", "op": "EQ", "value": 5}, "action": "ALERT", "score": 16},
      {"id": 6, "name": "eq str", "condition": {"type": "cmp", "field": "f_eq_str", "op": "EQ", "value": "INBOUND"}, "action": "ALERT", "score": 32},
      {"id": 7, "name": "eq bool", "condition": {"type": "cmp", "field": "f_eq_bool", "op": "EQ", "value": true}, "action": "FLAG", "score": 64},
      {"id": 8, "name": "ne", "condition": {"type": "cmp", "field": "f_ne", "op": "NE", "value": "OUTBOUND"}, "action": "ALERT", "score": 128},
      {"id": 9, "name": "in csv", "condition": {"type": "cmp", "field": "f_in", "op": "IN", "value": "5411, 5812,7995"}, "action": "HOLD", "score": 256},
      {"id": 10, "name": "contains", "condition": {"type": "cmp", "field": "f_contains", "op": "CONTAINS", "value": "cas"}, "action": "ALERT", "score": 512},
      {"id": 11, "name": "exists", "condition": {"type": "exists", "field": "f_exists"}, "action": "ALERT", "score": 1024},
      {"id": 12, "name": "in list", "condition": {"type": "in_list", "field": "f_list", "list": "countries"}, "action": "SUSPEND", "score": 2048},
      {"id": 13, "name": "always", "condition": {"type": "const", "value": true}, "action": "ALLOW", "score": 0},
      {"id": 14, "name": "never", "condition": {"type": "const", "value": false}, "action": "BLOCK", "score": 4096},
      {"id": 15, "name": "structuring band", "description": "nested all/any/not",
       "condition": {"type": "all", "all": [
         {"type": "cmp", "field": "g_amt", "op": "GTE", "value": 8100},
         {"type": "cmp", "field": "g_amt", "op": "LT", "value": 9000},
         {"type": "any", "any": [
           {"type": "cmp", "field": "g_dir", "op": "EQ", "value": "INBOUND"},
           {"type": "not", "not": {"type": "exists", "field": "g_flag"}}
         ]}
       ]}, "action": "HOLD", "score": 8192},
      {"id": 16, "name": "in number", "condition": {"type": "cmp", "field": "f_in_num", "op": "IN", "value": 7}, "action": "ALERT", "score": 16384},
      {"id": 17, "name": "contains on number", "condition": {"type": "cmp", "field": "f_contains_num", "op": "CONTAINS", "value": "23"}, "action": "ALERT", "score": 32768},
      {"id": 18, "name": "decimal text", "condition": {"type": "in_list", "field": "f_dec", "list": "decimals"}, "action": "ALERT", "score": 65536}
    ]
  },
  "cases": [
    {"name": "empty bag", "features": {}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "gt above", "features": {"f_gt": 101}, "expect": {"action": "ALERT", "score": 1, "triggered_rule_ids": [1, 13]}},
    {"name": "gt equal", "features": {"f_gt": 100}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "gt numeric string", "features": {"f_gt": "150"}, "expect": {"action": "ALERT", "score": 1, "triggered_rule_ids": [1, 13]}},
    {"name": "gt padded string is not a number", "features": {"f_gt": " 150"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "gt exponent string", "features": {"f_gt": "1e3"}, "expect": {"action": "ALERT", "score": 1, "triggered_rule_ids": [1, 13]}},
    {"name": "gt inf string is not a number", "features": {"f_gt": "inf"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "gt hex-suffix string is not a number", "features": {"f_gt": "500d"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "booleans compare as 1/0", "features": {"f_gt": true, "f_lt": true}, "expect": {"action": "ALERT", "score": 4, "triggered_rule_ids": [3, 13]}},
    {"name": "gte and lte at the boundary", "features": {"f_gte": 100, "f_lte": 100}, "expect": {"action": "ALERT", "score": 10, "triggered_rule_ids": [2, 4, 13]}},
    {"name": "just inside and outside", "features": {"f_lt": 99.999999, "f_lte": 100.0000001}, "expect": {"action": "ALERT", "score": 4, "triggered_rule_ids": [3, 13]}},
    {"name": "eq within tolerance", "features": {"f_eq_num": 5.0000000001}, "expect": {"action": "ALERT", "score": 16, "triggered_rule_ids": [5, 13]}},
    {"name": "eq outside tolerance", "features": {"f_eq_num": 5.00001}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "eq numeric string", "features": {"f_eq_num": "5"}, "expect": {"action": "ALERT", "score": 16, "triggered_rule_ids": [5, 13]}},
    {"name": "eq string exact", "features": {"f_eq_str": "INBOUND"}, "expect": {"action": "ALERT", "score": 32, "triggered_rule_ids": [6, 13]}},
    {"name": "eq string is case sensitive", "features": {"f_eq_str": "inbound"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "eq bool true", "features": {"f_eq_bool": true}, "expect": {"action": "FLAG", "score": 64, "triggered_rule_ids": [7, 13]}},
    {"name": "eq bool from string", "features": {"f_eq_bool": "true"}, "expect": {"action": "FLAG", "score": 64, "triggered_rule_ids": [7, 13]}},
    {"name": "eq bool from one", "features": {"f_eq_bool": 1}, "expect": {"action": "FLAG", "score": 64, "triggered_rule_ids": [7, 13]}},
    {"name": "ne on a different value", "features": {"f_ne": "INBOUND"}, "expect": {"action": "ALERT", "score": 128, "triggered_rule_ids": [8, 13]}},
    {"name": "ne on the same value", "features": {"f_ne": "OUTBOUND"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "ne on a missing field never fires", "features": {"f_ne": null}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "in csv with a number", "features": {"f_in": 5812}, "expect": {"action": "HOLD", "score": 256, "triggered_rule_ids": [9, 13]}},
    {"name": "in csv with a string", "features": {"f_in": "7995"}, "expect": {"action": "HOLD", "score": 256, "triggered_rule_ids": [9, 13]}},
    {"name": "in csv with a fraction", "features": {"f_in": 5812.5}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "contains is case sensitive", "features": {"f_contains": "Casino"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "contains substring", "features": {"f_contains": "mycasino"}, "expect": {"action": "ALERT", "score": 512, "triggered_rule_ids": [10, 13]}},
    {"name": "contains on a number's text", "features": {"f_contains_num": 12345}, "expect": {"action": "ALERT", "score": 32768, "triggered_rule_ids": [13, 17]}},
    {"name": "exists zero", "features": {"f_exists": 0}, "expect": {"action": "ALERT", "score": 1024, "triggered_rule_ids": [11, 13]}},
    {"name": "exists empty string", "features": {"f_exists": ""}, "expect": {"action": "ALERT", "score": 1024, "triggered_rule_ids": [11, 13]}},
    {"name": "exists null is absent", "features": {"f_exists": null}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "exists array is absent", "features": {"f_exists": [1, 2]}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "exists object is absent", "features": {"f_exists": {"a": 1}}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "in_list case insensitive", "features": {"f_list": "Kp"}, "expect": {"action": "SUSPEND", "score": 2048, "triggered_rule_ids": [12, 13]}},
    {"name": "in_list number text", "features": {"f_list": 42}, "expect": {"action": "SUSPEND", "score": 2048, "triggered_rule_ids": [12, 13]}},
    {"name": "in_list miss", "features": {"f_list": "ke"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "in_list null is absent", "features": {"f_list": null}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "nested band hits when flag absent", "features": {"g_amt": 8100, "g_dir": "OUTBOUND"}, "expect": {"action": "HOLD", "score": 8192, "triggered_rule_ids": [13, 15]}},
    {"name": "nested band blocked by flag", "features": {"g_amt": 8500, "g_dir": "OUTBOUND", "g_flag": true}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "nested band inbound with flag", "features": {"g_amt": 8500, "g_dir": "INBOUND", "g_flag": true}, "expect": {"action": "HOLD", "score": 8192, "triggered_rule_ids": [13, 15]}},
    {"name": "nested band at the ceiling", "features": {"g_amt": 9000}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "nested band below the floor", "features": {"g_amt": 8099.99}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "in with a numeric literal", "features": {"f_in_num": 7}, "expect": {"action": "ALERT", "score": 16384, "triggered_rule_ids": [13, 16]}},
    {"name": "in numeric literal from string", "features": {"f_in_num": "7.0"}, "expect": {"action": "ALERT", "score": 16384, "triggered_rule_ids": [13, 16]}},
    {"name": "in numeric literal miss", "features": {"f_in_num": "x"}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "decimal text half", "features": {"f_dec": 0.5}, "expect": {"action": "ALERT", "score": 65536, "triggered_rule_ids": [13, 18]}},
    {"name": "decimal text tiny", "features": {"f_dec": 1e-7}, "expect": {"action": "ALERT", "score": 65536, "triggered_rule_ids": [13, 18]}},
    {"name": "decimal text large", "features": {"f_dec": 12345678.9}, "expect": {"action": "ALERT", "score": 65536, "triggered_rule_ids": [13, 18]}},
    {"name": "decimal text miss", "features": {"f_dec": 0.25}, "expect": {"action": "ALLOW", "score": 0, "triggered_rule_ids": [13]}},
    {"name": "strongest action and summed score", "features": {"f_gt": 500, "f_in": "5411", "f_list": "IR", "f_eq_bool": true}, "expect": {"action": "SUSPEND", "score": 2369, "triggered_rule_ids": [1, 7, 9, 12, 13]}}
  ]
}
