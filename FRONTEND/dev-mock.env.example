# Copy to `.env.development.local` for local Console work without Control Plane.
# Never enable VITE_DEV_MOCK_API in production builds.
VITE_DEV_MOCK_API=true
# Set to false to screenshot the Network page disabled state (Neo4j off).
# VITE_DEV_MOCK_GRAPH_ANALYSIS=false
VITE_INCLUDE_OPERATOR_DOCS=true
VITE_OPERATOR_DOCS_BASE_URL=http://localhost:5175
