# Hokeka Edge — deployment configuration.
#
# `install.sh` / `install.ps1` generate a real `.env` from their arguments; they are the authority
# and this file mirrors exactly what they write, plus the two optional truststore variables that
# `docker-compose.yml` defaults to empty.
#
# Copy to `.env` and edit if you are wiring the stack by hand:
#     cp .env.example .env
#
# Variables NOT listed here are fixed inside the container and are not read from `.env`:
# EDGE_TLS_KEYSTORE (/opt/hokeka/secrets/edge-tls.p12), EDGE_IDENTITY_FILE
# (/opt/hokeka/data/edge-identity.json) and EDGE_BIND_ADDRESS (0.0.0.0 — the host-side exposure is
# controlled by EDGE_BIND below, not by this).

# ── Image ────────────────────────────────────────────────────────────────────────────────────────
EDGE_IMAGE=registry.hokeka.com/hokeka/edge-engine:0.1.0
AEROSPIKE_TAG=6.4

# ── Retention ────────────────────────────────────────────────────────────────────────────────────
# How long raw transactions are kept on your premises. This MUST match `default-ttl` in
# aerospike/aerospike.conf — the installers write both from `--retention-days`, and if you hand-wire
# them you must keep them in step. Records are written with an explicit TTL, so this value is what
# actually takes effect; the namespace default governs how you SIZE the data file.
#
# Raising retention raises RAM and disk linearly: Aerospike holds the primary index in memory at 64
# bytes per record. Size the data file with `--peak-tps` or see docs/edge-client-install-guide.md §2.
EDGE_RETENTION_DAYS=90

# ── Identity ─────────────────────────────────────────────────────────────────────────────────────
EDGE_PSPID=acme
EDGE_EDGEID=acme-1
CONTROLPLANE_URL=https://edge.hokeka.com

# One-time enrollment code issued in the portal after a platform admin approves the node.
# Consumed on first boot, then never needed again — the node persists its pinned credentials.
# Leave blank and the node boots UNAUTHORIZED: it answers HOLD and serves no ALLOW decisions.
EDGE_ENROLLMENT_CODE=

# ── Transaction API exposure ─────────────────────────────────────────────────────────────────────
# Host interface the local API is published on. Keep 127.0.0.1 unless the PSP's API nodes are on
# other hosts, in which case bind the private-network address and firewall it to that subnet.
EDGE_BIND=127.0.0.1

# ── TLS (server side: PSP API nodes -> edge) ─────────────────────────────────────────────────────
# The installers generate a self-signed EC P-384 PKCS#12 into ./secrets, write a random 32-character
# password here and mirror it to ./secrets/edge-tls.pass. Replace the certificate with one from the
# PSP's own CA for production, keeping the alias below.
#
# REQUIRED: compose refuses to render without it and the edge refuses to start without TLS. The
# value below is a placeholder so `docker compose config` validates — the installers overwrite it.
EDGE_TLS_KEYSTORE_PASSWORD=CHANGEME-the-installers-generate-a-random-password
EDGE_TLS_KEY_ALIAS=edge

# Require client certificates from the PSP's API nodes: none | want | need.
# `need` is the hardened setting — only holders of a PSP-issued client cert may submit transactions.
# It also needs SERVER_SSL_TRUST_STORE / SERVER_SSL_TRUST_STORE_PASSWORD pointed at your client CA.
EDGE_TLS_CLIENT_AUTH=none

# ── Pinned control-plane keys (trust anchors for HSE-1) ──────────────────────────────────────────
# Base64 SPKI (or raw 32 bytes), copied from the portal when the node is approved. The Ed25519 key
# verifies every rule bundle; the X25519 key encrypts the outbound metrics. Without them the node
# accepts no bundles and ships no metrics — it keeps evaluating on the last verified bundle only.
CONTROLPLANE_ED25519_PUBLIC_KEY=
CONTROLPLANE_X25519_PUBLIC_KEY=

# ── mTLS (client side: edge -> Hokeka control plane) ─────────────────────────────────────────────
# Issued by Hokeka when the node is approved; drop the PKCS#12 into ./secrets. Without these the
# node cannot pull rule bundles — the channel refuses to build a client without a certificate.
EDGE_MTLS_KEYSTORE=/opt/hokeka/secrets/edge-client.p12
EDGE_MTLS_KEYSTORE_PASSWORD=
# Optional: custom trust anchors for the control-plane server certificate.
# Leave empty to use the JDK default trust store.
EDGE_MTLS_TRUSTSTORE=
EDGE_MTLS_TRUSTSTORE_PASSWORD=
