{
  "permissions": {
    "allow": [
      "Bash(bash -n *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git check-ignore *)",
      "Bash(mvn -B --no-transfer-progress test *)",
      "Bash(mvn -B --no-transfer-progress test)",
      "Bash(mvn -B --no-transfer-progress compile *)",
      "Bash(mvn -B --no-transfer-progress compile)",
      "Bash(mvn -B -q --no-transfer-progress compile)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-syntax.sh",
            "timeout": 30,
            "statusMessage": "Checking syntax"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-key-material.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
