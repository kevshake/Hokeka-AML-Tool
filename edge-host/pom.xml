<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Hokeka Edge Host — the on-prem Spring Boot service deployed to PSP sites. Loads the Rust
         native core (libedge_engine.so) over JNI; falls back to a Java interpreter when absent.
         Containerised with Jib for one-command, Dockerfile-free, daemon-free deployment. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.hokeka</groupId>
    <artifactId>edge-host</artifactId>
    <version>0.1.0</version>
    <name>Hokeka Edge Host</name>

    <properties>
        <java.version>21</java.version>
        <jib.version>3.4.4</jib.version>
        <!-- Image coordinates (override on the CLI: -Dimage.registry=... -Dimage.tag=...) -->
        <image.registry>registry.hokeka.com</image.registry>
        <image.name>hokeka/edge-engine</image.name>
        <image.tag>${project.version}</image.tag>
        <!-- Where a locally built Rust core lives; used only by the `native-core` profile. -->
        <native.core.dir>${project.basedir}/../edge-engine/target/release</native.core.dir>
        <!-- Shared Edge data residency contract (schemas + fixtures). The schemas are packaged into
             the jar (the Edge validates every decision record before it enters the outbox) and the
             tests load the fixtures straight from here, never from a copy. -->
        <contracts.dir>${project.basedir}/../docs/contracts</contracts.dir>
        <!-- Virtual-thread friendly JDBC: pgjdbc 42.7 and HikariCP 5.1 replaced the synchronized
             blocks that pin a carrier thread (the evaluate path runs on virtual threads). -->
        <postgresql.version>42.7.4</postgresql.version>
        <HikariCP.version>5.1.0</HikariCP.version>
    </properties>

    <profiles>
        <!-- Opt-in verification against a real libedge_engine: `mvn test -Pnative-core`.
             The default build deliberately runs WITHOUT the native library, because that is how the
             container ships until CI stages the .so — the Java interpreter fallback must stay green
             on its own. *NativeIT classes are outside surefire's default includes, so they run only
             here, with java.library.path pointed at the built core. -->
        <profile>
            <id>native-core</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*NativeIT.java</include>
                            </includes>
                            <!-- Quoted: the path may contain spaces. Deliberately no
                                 "enable-native-access" flag: that is a JDK 22+ option and the CI
                                 toolchain is 21, where an unrecognised flag stops the forked JVM
                                 from starting at all. It only silences a warning anyway. -->
                            <argLine>"-Djava.library.path=${native.core.dir}"</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <!-- On-prem feature store. Aerospike is the client-premises datastore for transactions,
             velocity counters and the persisted rule bundle. jdk8 variant matches aml-microservice
             (the jdk21 variant is not needed and keeps the toolchain requirement lower). -->
        <dependency>
            <groupId>com.aerospike</groupId>
            <artifactId>aerospike-client-jdk8</artifactId>
            <version>9.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Edge Ledger (contract section 1): the site's PostgreSQL 16 system of record for
             evaluations and the decision-record outbox. Plain JDBC over HikariCP, schema managed by
             Flyway inside edge-host. Deliberately no spring-jdbc: the ledger owns its DataSource
             and Spring Boot's DataSource/Flyway auto-configuration stays out of the way, so a
             ledger outage can never stop the node from booting (it answers HOLD instead). -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- JSON Schema draft 2020-12 validator: decision records are validated against
             docs/contracts/decision-record-v2.schema.json before they are written to edge_outbox. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Ledger integration tests: Testcontainers when Docker is detectable, otherwise an explicit
             -Dledger.it.jdbc-url (see LedgerTestDatabase). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Package the contract schemas from their single source (docs/contracts) under
                 classpath:contracts/ — no checked-in copy that could drift. -->
            <resource>
                <directory>${contracts.dir}</directory>
                <targetPath>contracts</targetPath>
                <includes>
                    <include>**/*.schema.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Tests read the shared fixtures from here (contract section 13). -->
                        <contracts.dir>${contracts.dir}</contracts.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Jib: build the container image directly from Maven.
                 * mvn -pl edge-host package jib:buildTar   → image tarball (no daemon, offline-friendly)
                 * mvn -pl edge-host package jib:dockerBuild → load into local Docker daemon
                 * mvn -pl edge-host package jib:build       → push to the Hokeka registry -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib.version}</version>
                <configuration>
                    <from>
                        <image>eclipse-temurin:25-jre</image>
                    </from>
                    <to>
                        <image>${image.registry}/${image.name}:${image.tag}</image>
                    </to>
                    <container>
                        <ports>
                            <port>8443</port>
                        </ports>
                        <jvmFlags>
                            <!-- Find the Rust native core; permit JNI native access on modern JDKs. -->
                            <jvmFlag>-Djava.library.path=/opt/hokeka/lib</jvmFlag>
                            <jvmFlag>--enable-native-access=ALL-UNNAMED</jvmFlag>
                        </jvmFlags>
                        <environment>
                            <HOKEKA_EDGE_HOME>/opt/hokeka</HOKEKA_EDGE_HOME>
                        </environment>
                        <labels>
                            <org.opencontainers.image.title>Hokeka Edge Engine</org.opencontainers.image.title>
                            <org.opencontainers.image.vendor>Hokeka</org.opencontainers.image.vendor>
                        </labels>
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                    </container>
                    <extraDirectories>
                        <!-- Ships the native lib + default config into the image. CI drops the Linux
                             build (libedge_engine.so) into src/main/jib/opt/hokeka/lib before jib runs. -->
                        <paths>
                            <path>
                                <from>src/main/jib</from>
                                <into>/</into>
                            </path>
                        </paths>
                    </extraDirectories>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
