{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hokeka.com/edge/tunnel/notify/hold.place.schema.json",
  "title": "notify hold.place",
  "description": "Place a legal hold: matching Edge Ledger rows MUST survive retention purges until the hold is released. Idempotent on holdId. Scope is either explicit ids or a merchant + time range.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "holdId", "placedAt", "placedBy", "reasonCode", "reference", "scope"],
  "properties": {
    "type": { "const": "hold.place" },
    "holdId": { "$ref": "../../common.schema.json#/$defs/uuid" },
    "placedAt": { "$ref": "../../common.schema.json#/$defs/instant" },
    "placedBy": { "$ref": "../../common.schema.json#/$defs/userRef" },
    "reasonCode": { "enum": ["CASE", "SAR", "STR", "CTR", "REGULATOR_REQUEST", "LITIGATION"] },
    "reference": { "$ref": "../../common.schema.json#/$defs/workflowRef" },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["edgeAssessmentIds"],
          "properties": {
            "edgeAssessmentIds": {
              "type": "array",
              "items": { "$ref": "../../common.schema.json#/$defs/uuid" },
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["merchantId", "from", "to"],
          "properties": {
            "merchantId": { "$ref": "../../common.schema.json#/$defs/merchantId" },
            "from": { "$ref": "../../common.schema.json#/$defs/instant" },
            "to": { "$ref": "../../common.schema.json#/$defs/instant" }
          }
        }
      ]
    }
  }
}
