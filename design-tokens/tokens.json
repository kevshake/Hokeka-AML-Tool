{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "hokeka-design-tokens",
    "version": "1.0.0",
    "description": "Shared Hokeka AML glass palette — canonical with design-tokens/tokens.css"
  },
  "color": {
    "canvas": { "bg": "#080909", "bg2": "#0c0e0d" },
    "surface": {
      "0": "#080909",
      "1": "#0c0e0d",
      "2": "#121514",
      "3": "#191c1b",
      "4": "#232624"
    },
    "text": {
      "primary": "#f5f2eb",
      "secondary": "#a8aba8",
      "muted": "#858986"
    },
    "accent": {
      "gold": "#d3b371",
      "goldBright": "#e1c684",
      "goldDeep": "#74511e",
      "teal": "#75b7ab",
      "amber": "#e2b25d"
    },
    "semantic": {
      "success": "#75b7ab",
      "warning": "#e2b25d",
      "danger": "#e8776b",
      "info": "#84a9c4"
    },
    "line": {
      "default": "rgba(255, 255, 255, 0.12)",
      "strong": "rgba(255, 255, 255, 0.22)",
      "control": "rgba(255, 255, 255, 0.34)"
    },
    "glass": {
      "fill": "rgb(12 14 13 / 0.86)",
      "surface": "rgb(18 21 20 / 0.9)",
      "border": "rgba(255, 255, 255, 0.12)"
    }
  },
  "typography": {
    "fontDisplay": "'Manrope', 'Inter', system-ui, sans-serif",
    "fontBody": "'DM Sans', 'Inter', system-ui, sans-serif",
    "fontMono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "radius": { "base": "3px", "md": "4px", "lg": "5px", "pill": "9999px" },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem"
  },
  "motion": {
    "ease": "cubic-bezier(.22, 1, .36, 1)",
    "fast": "150ms",
    "base": "250ms",
    "slow": "400ms"
  },
  "shadow": {
    "sm": "0 10px 30px -18px rgba(0, 0, 0, 0.9)",
    "md": "0 26px 50px -30px rgba(0, 0, 0, 0.75)",
    "gold": "0 14px 34px -12px rgba(211, 179, 113, 0.6)"
  }
}
